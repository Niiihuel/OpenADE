{
  "version": 1,
  "agents": [
    {
      "id": "claude",
      "label": "Claude Code",
      "executables": ["claude"],
      "accept_all_args": ["--dangerously-skip-permissions"],
      "read_only_args": ["--permission-mode", "plan"],
      "new_session_args": ["--session-id", "{session}"],
      "resume_args": ["--resume", "{session}"],
      "sessions": "claude_projects",
      "bridge": "claude_mcp_config",
      "status": "claude_hooks",
      "selection_reference": "@{path}#L{lines}"
    },
    {
      "id": "codex",
      "label": "Codex",
      "executables": ["codex"],
      "accept_all_args": ["--dangerously-bypass-approvals-and-sandbox"],
      "read_only_args": ["--sandbox", "read-only"],
      "resume_args": ["resume", "{session}"],
      "sessions": "codex_rollouts",
      "bridge": "codex_config",
      "status": "codex_notifications",
      "selection_reference": "{path}:{lines}"
    },
    {
      "id": "opencode",
      "label": "opencode",
      "executables": ["opencode"],
      "accept_all_args": ["--auto"],
      "read_only_args": ["--agent", "plan"],
      "resume_args": ["--session", "{session}"],
      "sessions": "opencode_list",
      "bridge": null,
      "selection_reference": "@{path}#L{lines}"
    }
  ]
}
