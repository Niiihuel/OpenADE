{
  "version": 1,
  "providers": [
    {
      "id": "openai",
      "name": "OpenAI",
      "endpoint": "https://api.openai.com/v1",
      "key_env": "OPENAI_API_KEY",
      "wire_api": "responses",
      "model_list_path": "models"
    },
    {
      "id": "anthropic",
      "name": "Anthropic",
      "endpoint": "https://api.anthropic.com/v1",
      "key_env": "ANTHROPIC_API_KEY",
      "wire_api": "anthropic_messages",
      "auth": {
        "type": "header",
        "name": "x-api-key"
      },
      "headers": {
        "anthropic-version": "2023-06-01"
      },
      "model_list_path": "models",
      "catalog": {
        "name_path": "display_name",
        "input_limit_path": "max_input_tokens",
        "max_output_path": "max_tokens",
        "effort_levels_path": "capabilities.effort",
        "effort_format": "supported_object",
        "capability_support_paths": {
          "batch": "capabilities.batch.supported",
          "citations": "capabilities.citations.supported",
          "code_execution": "capabilities.code_execution.supported",
          "context_management": "capabilities.context_management.supported",
          "effort": "capabilities.effort.supported",
          "image_input": "capabilities.image_input.supported",
          "pdf_input": "capabilities.pdf_input.supported",
          "structured_outputs": "capabilities.structured_outputs.supported",
          "thinking": "capabilities.thinking.supported",
          "adaptive_thinking": "capabilities.thinking.types.adaptive.supported",
          "enabled_thinking": "capabilities.thinking.types.enabled.supported"
        },
        "pagination": {
          "cursor_query": "after_id",
          "cursor_path": "last_id",
          "has_more_path": "has_more",
          "limit_query": "limit",
          "limit": 1000
        }
      }
    },
    {
      "id": "openrouter",
      "name": "OpenRouter",
      "endpoint": "https://openrouter.ai/api/v1",
      "key_env": "OPENROUTER_API_KEY",
      "wire_api": "chat_completions",
      "model_list_path": "models/user",
      "catalog_list_path": "models?output_modalities=all",
      "catalog_anonymous": true,
      "catalog": {
        "context_window_path": "context_length",
        "max_output_path": "top_provider.max_completion_tokens",
        "tool_call_path": "supported_parameters",
        "tool_call_contains": "tools",
        "input_modalities_path": "architecture.input_modalities",
        "output_modalities_path": "architecture.output_modalities",
        "pricing_input_path": "pricing.prompt",
        "pricing_output_path": "pricing.completion",
        "price_unit": "per_token"
      }
    },
    {
      "id": "deepseek",
      "name": "DeepSeek",
      "endpoint": "https://api.deepseek.com",
      "key_env": "DEEPSEEK_API_KEY",
      "wire_api": "chat_completions",
      "model_list_path": "models",
      "chat_request_fields": {
        "thinking": {
          "type": "disabled"
        }
      },
      "catalog": {
        "context_window_path": "context_window",
        "max_output_path": "max_output_tokens",
        "effort_levels_path": "effort.supported_levels",
        "input_modalities_path": "input_modalities",
        "output_modalities_path": "output_modalities"
      }
    },
    {
      "id": "minimax",
      "name": "MiniMax",
      "endpoint": "https://api.minimax.io/v1",
      "key_env": "MINIMAX_API_KEY",
      "wire_api": "chat_completions",
      "model_list_path": "models",
      "reasoning_effort_field": "reasoning_effort",
      "chat_request_fields": {
        "reasoning_split": true,
        "stream_options": { "include_usage": true }
      }
    },
    {
      "id": "zai",
      "name": "GLM · Z.ai",
      "endpoint": "https://api.z.ai/api/paas/v4",
      "key_env": "ZAI_API_KEY",
      "wire_api": "chat_completions",
      "model_list_path": null,
      "reasoning_effort_field": "reasoning_effort",
      "chat_request_fields": {
        "thinking": { "type": "enabled", "clear_thinking": false }
      }
    },
    {
      "id": "groq",
      "name": "Groq",
      "endpoint": "https://api.groq.com/openai/v1",
      "key_env": "GROQ_API_KEY",
      "wire_api": "chat_completions",
      "model_list_path": "models",
      "catalog": {
        "context_window_path": "context_window",
        "max_output_path": "max_completion_tokens"
      }
    },
    {
      "id": "mistral",
      "name": "Mistral",
      "endpoint": "https://api.mistral.ai/v1",
      "key_env": "MISTRAL_API_KEY",
      "wire_api": "chat_completions",
      "model_list_path": "models",
      "catalog": {
        "context_window_path": "max_context_length",
        "tool_call_path": "capabilities.function_calling"
      }
    },
    {
      "id": "xai",
      "name": "xAI",
      "endpoint": "https://api.x.ai/v1",
      "key_env": "XAI_API_KEY",
      "wire_api": "chat_completions",
      "model_list_path": "language-models",
      "catalog": {
        "entries_path": "models",
        "effort_levels_path": "capabilities.reasoning_effort",
        "input_modalities_path": "input_modalities",
        "output_modalities_path": "output_modalities",
        "pricing_input_path": "prompt_text_token_price",
        "pricing_output_path": "completion_text_token_price",
        "price_unit": "usd_cents_per_100m_tokens"
      }
    },
    {
      "id": "custom",
      "name": "Personalizado",
      "endpoint": "https://api.openai.com/v1",
      "key_env": "OPENIDE_API_KEY",
      "wire_api": "chat_completions",
      "model_list_path": null,
      "user_endpoint": true,
      "key_optional": true
    },
    {
      "id": "codex",
      "name": "Codex",
      "endpoint": "https://api.openai.com/v1",
      "key_env": "OPENIDE_CODEX_ACCESS_TOKEN",
      "wire_api": "responses",
      "model_list_path": "models",
      "catalog": {
        "entries_path": "models",
        "id_path": "slug",
        "name_path": "display_name",
        "visibility_path": "visibility",
        "visibility_value": "list",
        "context_window_path": "context_window",
        "max_output_path": "max_output_tokens",
        "effort_levels_path": "supported_reasoning_levels",
        "input_modalities_path": "input_modalities",
        "effort_format": "preset_array"
      }
    },
    {
      "id": "opencode",
      "name": "OpenCode Zen",
      "endpoint": "https://opencode.ai/zen/v1",
      "key_env": "OPENCODE_API_KEY",
      "wire_api": "chat_completions",
