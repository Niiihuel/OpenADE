# Upload allowlist. Use scripts/eas.mjs to also limit EAS_PROJECT_ROOT.
*
!package.json
!package-lock.json
!app.json
!eas.json
!.easignore
!.eas
!.eas/build
!.eas/build/*.yml
!scripts
!scripts/*.py
!scripts/*.sh
!scripts/*.mjs
!ios
!ios/OpenADERemote.xcodeproj
