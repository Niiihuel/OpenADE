!ios/OpenADERemote.xcodeproj/xcshareddata
!ios/OpenADERemote.xcodeproj/xcshareddata/xcschemes
!ios/OpenADERemote.xcodeproj/xcshareddata/xcschemes/*.xcscheme
!OpenADERemote
!OpenADERemote/Models
!OpenADERemote/Networking
!OpenADERemote/Security
!OpenADERemote/State
!OpenADERemote/Views
!OpenADERemote/**/*.swift
!OpenADERemote/Info.plist
!OpenADERemote/Simulator.entitlements
!OpenADERemote/OpenADERemote.entitlements
!OpenADERemote/PrivacyInfo.xcprivacy
!OpenADERemote/Assets.xcassets
