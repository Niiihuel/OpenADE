# Set these in the process environment before launching Agents Window.
# Never commit a real API key.
OPENIDE_API_KEY=
OPENIDE_API_BASE=https://api.openai.com/v1
OPENIDE_MODEL=gpt-4.1
# Variables para proveedores seleccionables en Settings:
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
# Proveedores agregados en provider-registry.json usan su propia key_env.
